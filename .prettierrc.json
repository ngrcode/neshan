    "^@emotion/(.*)$",
    "^antd$",
    "^antd/(.*)$",

    "^@tanstack/(.*)$",
    "^@tanstack/query-core$",
    "^path$",
    "^@mui/(.*)$",
    "^@ant-design/(.*)$",
    "^@repo/ui$",
